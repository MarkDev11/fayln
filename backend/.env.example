# Contoh konfigurasi fayLN backend.
#
# Salin menjadi .env untuk pengembangan lokal. JANGAN commit berkas .env.
# Di blitz.cloud, variabel diisi pada tab Environment milik aplikasi.

# Wajib. Port yang didengarkan server.
# blitz.cloud menyuntikkan nilainya sendiri; di lokal boleh diisi bebas.
PORT=8080

# Wajib. Alamat PostgreSQL.
# blitz.cloud mengisi ini otomatis saat database disambungkan ke aplikasi.
DATABASE_URL=postgres://fayln:fayln@localhost:5432/fayln

# Opsional. Tingkat log: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Opsional. Asal yang diizinkan untuk CORS, dipisahkan koma.
# Kosong berarti hanya permintaan tanpa Origin (aplikasi native) yang dilayani.
CORS_ORIGINS=

# Opsional. Jalankan migrasi otomatis saat server mulai.
# Bawaan true supaya deploy pertama tidak memerlukan langkah manual.
RUN_MIGRATIONS_ON_START=true

# ---- Batas paket (angka, bukan rahasia) ----
FREE_DAILY_TOKENS=100000
PAID_DAILY_TOKENS=1000000
FREE_CONTEXT_TOKENS=64000
PAID_CONTEXT_TOKENS=256000

# ---- Rate limit (FR-73) ----
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
